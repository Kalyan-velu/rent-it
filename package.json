{
  "name": "rent-a-wheel",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "openapi:generate": "orval --config packages/api-client/orval.config.ts",
    "openapi:watch": "orval --config packages/api-client/orval.config.ts --watch",
    "openapi:validate": "redocly lint packages/api-spec/openapi.yaml",
    "db:generate": "cd packages/database && pnpm run db:generate",
    "db:push": "cd packages/database && pnpm run db:push",
    "db:migrate": "cd packages/database && pnpm run db:migrate",
    "db:studio": "cd packages/database && pnpm run db:studio"
  },
  "devDependencies": {
    "prettier": "~3.8.1",
    "turbo": "^2.7.6",
    "typescript": "^5.9.3",
    "@types/node": "^22.19.7",
    "@redocly/cli": "^2.15.0",
    "orval": "^8.1.0"
  },
  "packageManager": "pnpm@10.28.1+sha512.7d7dbbca9e99447b7c3bf7a73286afaaf6be99251eb9498baefa7d406892f67b879adb3a1d7e687fc4ccc1a388c7175fbaae567a26ab44d1067b54fcb0d6a316",
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "catalogs": {
      "default": {
      "eslint": "^9.39.2",
      "@eslint/js": "^9.39.2",
      "typescript-eslint": "^8.53.1",
      "eslint-plugin-react": "^7.37.5",
      "eslint-plugin-react-hooks": "^7.0.1",
      "eslint-plugin-only-warn": "^1.1.0",
      "eslint-plugin-turbo": "^2.7.6",
      "@next/eslint-plugin-next": "^16.1.4",
      "globals": "^17.1.0",

      "typescript": "^5.9.3",
      "@types/node": "^22.19.7",
      "@types/react": "^19.2.9",
      "@types/react-dom": "^19.2.3",

      "react": "^19.2.3",
      "react-dom": "^19.2.3",

      "vite": "^7.3.1",
      "vitest": "^4.0.18",
      "@vitejs/plugin-react": "^5.1.2",
      "@vitest/ui": "^4.0.18",

      "tailwindcss": "^4.1.18",
      "@tailwindcss/postcss": "^4.1.18",
      "postcss": "^8.5.6",

      "zod": "^4.3.6",

      "jest": "^30.2.0",
      "@types/jest": "^30.0.0",
      "ts-jest": "^29.4.6",
      "supertest": "^7.2.2",
      "@types/supertest": "^6.0.3",
      "tsx": "^4.21.0",

      "@prisma/client": "^7.3.0",
      "prisma": "^7.3.0",
      "@prisma/adapter-pg": "^7.3.0",
      "dotenv": "^17.2.3",

      "bcrypt": "^6.0.0",
      "@types/bcrypt": "^6.0.0",
      "jsonwebtoken": "^9.0.3",
      "@types/jsonwebtoken": "^9.0.10"
      }
    }
  }
}
