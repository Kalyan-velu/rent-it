{
  "name": "rent-a-wheel",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "openapi:generate": "orval --config packages/openapi/orval.config.ts",
    "openapi:watch": "orval --config packages/openapi/orval.config.ts --watch",
    "openapi:validate": "redocly lint packages/openapi/openapi.yaml",
    "db:generate": "cd packages/database && pnpm run db:generate",
    "db:push": "cd packages/database && pnpm run db:push",
    "db:migrate": "cd packages/database && pnpm run db:migrate",
    "db:studio": "cd packages/database && pnpm run db:studio"
  },
  "devDependencies": {
    "prettier": "~3.8.1",
    "turbo": "^2.7.6",
    "typescript": "^5.9.3",
    "@types/node": "^22.19.7",
    "@redocly/cli": "^1.25.6",
    "orval": "^7.3.0"
  },
  "packageManager": "pnpm@10.28.1+sha512.7d7dbbca9e99447b7c3bf7a73286afaaf6be99251eb9498baefa7d406892f67b879adb3a1d7e687fc4ccc1a388c7175fbaae567a26ab44d1067b54fcb0d6a316",
  "engines": {
    "node": ">=18"
  }
}
