# Server Configuration
NODE_ENV=development
PORT=4000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# Database
DATABASE_URL="postgresql://user:password@localhost:5432/rent_a_wheel?schema=public"

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# OAuth Providers (for future implementation)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Passkey (WebAuthn) Configuration
WEBAUTHN_RP_NAME="Rent-a-Wheel"
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGIN=http://localhost:3000

# AWS Configuration
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET_NAME=rent-a-wheel-uploads

# Email Service (AWS SES or Resend)
EMAIL_PROVIDER=resend
# For Resend
RESEND_API_KEY=
# For AWS SES
AWS_SES_REGION=us-east-1
EMAIL_FROM=noreply@rent-a-wheel.com

# Kafka Configuration
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=rent-a-wheel-api
KAFKA_GROUP_ID=rent-a-wheel-consumers

# Payment Gateway (Cashfree)
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_MODE=sandbox # or production

# WhatsApp Integration (Twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=

# Slack Integration
SLACK_WEBHOOK_URL=

# Sentry (Error Monitoring)
SENTRY_DSN=

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
