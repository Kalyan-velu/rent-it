{
  "name": "@rent-a-wheel/api-client",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/generated/rentAWheelAPI.ts",
      "default": "./src/generated/rentAWheelAPI.ts"
    },
    "./schemas/*": {
      "types": "./src/generated/schemas/*",
      "default": "./src/generated/schemas/*"
    },
    "./endpoints/*": {
      "types": "./src/generated/endpoints/*",
      "default": "./src/generated/endpoints/*"
    }
  },
  "scripts": {
    "generate": "orval",
    "generate:watch": "orval --watch"
  },
  "dependencies": {
    "@rent-a-wheel/typescript-config": "workspace:*",
    "@rent-a-wheel/api-spec": "workspace:*",
    "@tanstack/react-query": "^5.90.20",
    "axios": "^1.13.5",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "orval": "^8.1.0",
    "typescript": "^5.9.3"
  }
}
