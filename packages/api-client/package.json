{
  "name": "@rent-a-wheel/api-client",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "./src/generated/index.ts",
  "types": "./src/generated/index.ts",
  "exports": {
    ".": {
      "types": "./src/generated/index.ts",
      "import": "./src/generated/index.ts"
    },
    "./schemas/*": {
      "types": "./src/generated/schemas/**/*.ts",
      "import": "./src/generated/schemas/**/*.ts"
    },
    "./zod": {
      "types": "./src/generated/endpoints/**/*.zod.ts",
      "import": "./src/generated/endpoints/**/*.zod.ts"
    }
  },
  "scripts": {
    "generate": "orval",
    "generate:watch": "orval --watch"
  },
  "dependencies": {
    "@rent-a-wheel/api-spec": "workspace:*",
    "@tanstack/react-query": "^5.80.6",
    "axios": "^1.9.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "orval": "^8.1.0",
    "typescript": "^5.9.3"
  }
}