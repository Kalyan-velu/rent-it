# Automatically handle peer dependencies
auto-install-peers=true

# Link workspace packages (essential for monorepo dev)
link-workspace-packages=true

# Use workspace protocol when adding packages
save-workspace-protocol=rolling

# Warn about peer dependency issues
strict-peer-dependencies=true

# Hoist dev tools to root for editor integration
public-hoist-pattern[]=*eslint*
public-hoist-pattern[]=*prettier*
public-hoist-pattern[]=*typescript*